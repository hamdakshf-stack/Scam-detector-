// 11. Report New Scam Term
void reportScam() {
    char newWord[100];
    FILE *f;
    printf("\nEnter new scam word / number to report: ");
    if (fgets(newWord, 100, stdin) == NULL) {
        return;
    }
    newWord[strcspn(newWord, "\n")] = '\0';
    toLower(newWord);
    if (newWord[0] == '\0') {
        printf(YELLOW "No word entered!\n" RESET);
        return;
    }
    if (isDuplicate(newWord)) {
        printf(YELLOW "This word is already in the database!\n" RESET);
        return;
    }
    if (reportedCount >= 100) {
        printf(RED "Database is full! Could not save.\n" RESET);
        return;
    }
    f = fopen("reported_scams.txt", "a");
    if (f != NULL) {
        fprintf(f, "%s\n", newWord);
        fclose(f);
        strcpy(reportedWords[reportedCount], newWord);
        reportedCount++;
        printf(GREEN "Thank you! '%s' saved in reported_scams.txt\n" RESET, newWord);
        printf(GREEN "Our database will be updated. Stay Safe!\n" RESET);
    }
    else {
        printf(RED "File error! Could not save.\n" RESET);
    }
}

