// 4. Convert Message to Lowercase
void toLower(char *s) {
    int i;
    for (i = 0; s[i] != '\0'; i++) {
        s[i] = tolower((unsigned char)s[i]);
    }
}

// Check Whether a Reported Word Already Exists
int isDuplicate(char word[]) {
    int i;
    for (i = 0; i < reportedCount; i++) {
        if (strcmp(reportedWords[i], word) == 0) {
            return 1;
        }
    }
    return 0;
}

// Load Previously Reported Words from File
void loadReportedScams() {
    FILE *f;
    char word[100];
    f = fopen("reported_scams.txt", "r");
    if (f == NULL) {
        return;
    }
    while (fgets(word, 100, f) != NULL && reportedCount < 100) {
        word[strcspn(word, "\n")] = '\0';
        toLower(word);
        if (word[0] != '\0' && !isDuplicate(word)) {
            strcpy(reportedWords[reportedCount], word);
            reportedCount++;
        }
    }
    fclose(f);
}

// 5. Get Risk Level
const char* getRiskLevel(int score) {
    if (score >= 70) {
        return "HIGH RISK";
    }
    else if (score >= 20) {
        return "SUSPICIOUS";
    }
    else {
        return "SAFE";
    }
}

// 6. Visual Risk Meter
void riskMeter(int score) {
    int bars;
    int i;
    bars = score / 10;
    if (bars > 10) {
        bars = 10;
    }
    printf("  Risk Meter: [");
    for (i = 0; i < 10; i++) {
        if (i < bars) {
            if (score >= 70)
                printf(RED "#");
            else if (score >= 20)
                printf(YELLOW "#");
            else
                printf(GREEN "#");
        }
        else {
            printf("-");
        }
    }
    printf("] %d/100 - %s\n" RESET, score, getRiskLevel(score));
}

