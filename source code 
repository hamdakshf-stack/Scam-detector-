                if (strstr(msg, scamWords[i]) != NULL)
                {
                    printf(RED "  [MESSAGE] Found: %s (+20 points)\n" RESET, scamWords[i]);
                    msgFound++;
                }
            }
            // Check User-Reported Scam Words
            for (i = 0; i < reportedCount; i++)
            {
                alreadyFound = 0;
                for (j = 0; j < scamCount; j++)
                {
                    if (strcmp(reportedWords[i], scamWords[j]) == 0)
                    {
                        alreadyFound = 1;
                        break;
                    }
                }
                if (!alreadyFound && strstr(msg, reportedWords[i]) != NULL)
                {
                    printf(RED "  [MESSAGE] Found: %s (+20 points)\n" RESET, reportedWords[i]);
                    msgFound++;
                }
