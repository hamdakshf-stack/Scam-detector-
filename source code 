                if (strstr(msg, locationWords[i]) != NULL)
                {
                    printf(RED "  [LOCATION] Found: %s (+25 points)\n" RESET, locationWords[i]);
                    locFound++;
                }
            }
            if (locFound == 0)
            {
                printf(GREEN "  No location scam found\n" RESET);
            }
            // Check Surveillance Scam
            printf(BOLD "Checking Surveillance Scam:\n" RESET);
            for (i = 0; i < survCount; i++)
